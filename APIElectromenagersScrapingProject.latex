\begin{Shaded}
\begin{Highlighting}[]
\AttributeTok{@app.route}\NormalTok{(}\StringTok{\textquotesingle{}/\textquotesingle{}}\NormalTok{)}
\KeywordTok{def}\NormalTok{ home():}
    \ControlFlowTok{return}\NormalTok{ render\_template\_string(}\StringTok{"""}
\StringTok{        \textless{}!DOCTYPE html\textgreater{}}
\StringTok{        \textless{}html lang="en"\textgreater{}}
\StringTok{        \textless{}head\textgreater{}}
\StringTok{            \textless{}meta charset="UTF{-}8"\textgreater{}}
\StringTok{            \textless{}meta name="viewport" content="width=device{-}width, initial{-}scale=1.0"\textgreater{}}
\StringTok{            \textless{}title\textgreater{}Data Analysis Web App\textless{}/title\textgreater{}}
\StringTok{            \textless{}style\textgreater{}}
\StringTok{                body \{ font{-}family: Arial, sans{-}serif; \}}
\StringTok{                .container \{ width: 80\%; margin: 0 auto; padding: 20px; \}}
\StringTok{                .button \{ margin: 10px 0; padding: 10px 20px; background{-}color: \#4CAF50; color: white; border: none; cursor: pointer; \}}
\StringTok{                .results \{ margin{-}top: 20px; \}}
\StringTok{                pre \{ background{-}color: \#f4f4f4; padding: 10px; \}}
\StringTok{                .plot \{ margin{-}top: 20px; text{-}align: center; \}}
\StringTok{                \#loader \{ display: none; \}}
\StringTok{                .result{-}item \{ margin: 10px 0; padding: 10px; border: 1px solid \#ddd; background{-}color: \#f9f9f9; \}}
\StringTok{                .result{-}item h3 \{ margin: 0; \}}
\StringTok{                .result{-}item .key \{ font{-}weight: bold; \}}
\StringTok{                .result{-}item .value \{ margin{-}left: 10px; \}}
\StringTok{                .search{-}bar \{ margin{-}right: 10px; \}}
\StringTok{            \textless{}/style\textgreater{}}
\StringTok{        \textless{}/head\textgreater{}}
\StringTok{        \textless{}body\textgreater{}}

\StringTok{            \textless{}div class="container"\textgreater{}}
\StringTok{                \textless{}h1\textgreater{}Products Analysis Web App\textless{}/h1\textgreater{}}

\StringTok{                \textless{}!{-}{-} Search Bar and Button {-}{-}\textgreater{}}
\StringTok{                \textless{}input type="text" id="searchInput" class="search{-}bar" placeholder="Search Similar Products"\textgreater{}}
\StringTok{                \textless{}button class="button" onclick="searchSimilarProducts()"\textgreater{}Search Similar Products\textless{}/button\textgreater{}}
\StringTok{                \textless{}button class="button" onclick="getData(\textquotesingle{}analyse\_promotions\textquotesingle{})"\textgreater{}Analyze Promotions by Category\textless{}/button\textgreater{}}
\StringTok{                \textless{}button class="button" onclick="getData(\textquotesingle{}analyse\_top\_product\textquotesingle{})"\textgreater{}Analyze Products by Different Sites\textless{}/button\textgreater{}}
\StringTok{                \textless{}button class="button" onclick="getData(\textquotesingle{}site\_grouped\_sites\textquotesingle{})"\textgreater{}Analyze Products in Same Site\textless{}/button\textgreater{}}
\StringTok{                \textless{}button class="button" onclick="getData(\textquotesingle{}site\_grouped\_sites\textquotesingle{})"\textgreater{}Analyze Products by All Sites\textless{}/button\textgreater{}}
\StringTok{                }
\StringTok{                \textless{}br /\textgreater{}}
\StringTok{                \textless{}button class="button" onclick="generatePlot(\textquotesingle{}plot\_analyse\_promotions\textquotesingle{})"\textgreater{}Visualize Promotions by Category\textless{}/button\textgreater{}}
\StringTok{                \textless{}button class="button" onclick="generatePlot(\textquotesingle{}plot\_analyse\_top\_product\textquotesingle{})"\textgreater{}Visualize Products by Different Sites\textless{}/button\textgreater{}}
\StringTok{                \textless{}button class="button" onclick="generatePlot(\textquotesingle{}plot\_products\_by\_date\textquotesingle{})"\textgreater{}Visualize Products in Same Site\textless{}/button\textgreater{}}
\StringTok{                \textless{}button class="button" onclick="generatePlot(\textquotesingle{}plot\_site\_grouped\_sites\textquotesingle{})"\textgreater{}Visualize Products by All Sites\textless{}/button\textgreater{}}

\StringTok{                \textless{}div id="loader"\textgreater{}Loading...\textless{}/div\textgreater{}}
\StringTok{                \textless{}div class="plot" id="plotContainer"\textgreater{}\textless{}/div\textgreater{}}

\StringTok{                \textless{}div class="results"\textgreater{}}
\StringTok{                    \textless{}h2\textgreater{}Results\textless{}/h2\textgreater{}}
\StringTok{                    \textless{}div id="resultOutput"\textgreater{}\textless{}/div\textgreater{}}
\StringTok{                \textless{}/div\textgreater{}}

\StringTok{            \textless{}/div\textgreater{}}

\StringTok{            \textless{}script\textgreater{}}
\StringTok{                const apiBaseUrl = \textquotesingle{}http://localhost:5000/\textquotesingle{};  // Assuming your Flask server is running locally}

\StringTok{                // Function to show loader}
\StringTok{                function showLoader() \{}
\StringTok{                    document.getElementById(\textquotesingle{}loader\textquotesingle{}).style.display = \textquotesingle{}block\textquotesingle{};}
\StringTok{                \}}

\StringTok{                // Function to hide loader}
\StringTok{                function hideLoader() \{}
\StringTok{                    document.getElementById(\textquotesingle{}loader\textquotesingle{}).style.display = \textquotesingle{}none\textquotesingle{};}
\StringTok{                \}}

\StringTok{                // Function to call Flask API and display results}
\StringTok{                function getData(endpoint) \{}
\StringTok{                    showLoader();  // Show loader before the request}

\StringTok{                    fetch(apiBaseUrl + endpoint)}
\StringTok{                        .then(response =\textgreater{} response.json())}
\StringTok{                        .then(data =\textgreater{} \{}
\StringTok{                            hideLoader();  // Hide loader once data is fetched}
\StringTok{                            displayData(data);  // Function to display data in divs}
\StringTok{                        \})}
\StringTok{                        .catch(error =\textgreater{} \{}
\StringTok{                            hideLoader();  // Hide loader in case of an error}
\StringTok{                            document.getElementById(\textquotesingle{}resultOutput\textquotesingle{}).innerHTML = \textasciigrave{}Error: $}\SpecialCharTok{\{error\}}\StringTok{\textasciigrave{};}
\StringTok{                        \});}
\StringTok{                \}}

\StringTok{                // Function to handle Search Similar Products request with search query}
\StringTok{                function searchSimilarProducts() \{}
\StringTok{                    const query = document.getElementById(\textquotesingle{}searchInput\textquotesingle{}).value;  // Get the search query}

\StringTok{                    if (query) \{}
\StringTok{                        showLoader();  // Show loader before the request}

\StringTok{                        fetch(apiBaseUrl + \textquotesingle{}search\_similar\_products?product\_name=\textquotesingle{} + encodeURIComponent(query))}
\StringTok{                            .then(response =\textgreater{} response.json())}
\StringTok{                            .then(data =\textgreater{} \{}
\StringTok{                                hideLoader();  // Hide loader once data is fetched}
\StringTok{                                displayData(data);  // Function to display data in divs}
\StringTok{                            \})}
\StringTok{                            .catch(error =\textgreater{} \{}
\StringTok{                                hideLoader();  // Hide loader in case of an error}
\StringTok{                                document.getElementById(\textquotesingle{}resultOutput\textquotesingle{}).innerHTML = \textasciigrave{}Error: $}\SpecialCharTok{\{error\}}\StringTok{\textasciigrave{};}
\StringTok{                            \});}
\StringTok{                    \} else \{}
\StringTok{                        alert(\textquotesingle{}Please enter a search term.\textquotesingle{});}
\StringTok{                    \}}
\StringTok{                \}}

\StringTok{                // Function to display JSON data in divs}
\StringTok{                function displayData(data) \{}
\StringTok{                    const resultDiv = document.getElementById(\textquotesingle{}resultOutput\textquotesingle{});}
\StringTok{                    resultDiv.innerHTML = \textquotesingle{}\textquotesingle{};  // Clear previous results}

\StringTok{                    // Recursive function to display data as divs}
\StringTok{                    function createDivs(item, parentDiv) \{}
\StringTok{                        if (Array.isArray(item)) \{}
\StringTok{                            item.forEach((subItem, index) =\textgreater{} \{}
\StringTok{                                const div = document.createElement(\textquotesingle{}div\textquotesingle{});}
\StringTok{                                div.className = \textquotesingle{}result{-}item\textquotesingle{};}
\StringTok{                                div.innerHTML = \textasciigrave{}\textless{}h3\textgreater{}Item $\{index + 1\}:\textless{}/h3\textgreater{}\textasciigrave{};}
\StringTok{                                createDivs(subItem, div); // Recursively handle array elements}
\StringTok{                                parentDiv.appendChild(div);}
\StringTok{                            \});}
\StringTok{                        \} else if (typeof item === \textquotesingle{}object\textquotesingle{} \&\& item !== null) \{}
\StringTok{                            Object.keys(item).forEach(key =\textgreater{} \{}
\StringTok{                                const div = document.createElement(\textquotesingle{}div\textquotesingle{});}
\StringTok{                                div.className = \textquotesingle{}key{-}value{-}pair\textquotesingle{};}
\StringTok{                                div.innerHTML = \textasciigrave{}\textless{}span class="key"\textgreater{}$}\SpecialCharTok{\{key\}}\StringTok{:\textless{}/span\textgreater{}\textasciigrave{};}
\StringTok{                                const valueDiv = document.createElement(\textquotesingle{}div\textquotesingle{});}
\StringTok{                                valueDiv.className = \textquotesingle{}value\textquotesingle{};}
\StringTok{                                }
\StringTok{                                // Recursively handle nested objects or arrays}
\StringTok{                                createDivs(item[key], valueDiv);}
\StringTok{                                }
\StringTok{                                div.appendChild(valueDiv);}
\StringTok{                                parentDiv.appendChild(div);}
\StringTok{                            \});}
\StringTok{                        \} else \{}
\StringTok{                            const div = document.createElement(\textquotesingle{}div\textquotesingle{});}
\StringTok{                            div.className = \textquotesingle{}value\textquotesingle{};}
\StringTok{                            div.innerHTML = \textasciigrave{}$}\SpecialCharTok{\{item\}}\StringTok{\textasciigrave{}; // Display the value if it\textquotesingle{}s a simple data type}
\StringTok{                            parentDiv.appendChild(div);}
\StringTok{                        \}}
\StringTok{                    \}}

\StringTok{                    // Call the recursive function on the data}
\StringTok{                    createDivs(data, resultDiv);}
\StringTok{                \}}


\StringTok{                // Function to generate plot}
\StringTok{                function generatePlot(endpoint) \{}
\StringTok{                }
\StringTok{                    showLoader();  // Show loader before the request}

\StringTok{                    fetch(apiBaseUrl + endpoint)}
\StringTok{                        .then(response =\textgreater{} response.blob())}
\StringTok{                        .then(imageBlob =\textgreater{} \{}
\StringTok{                            hideLoader();  // Hide loader once the plot is generated}
\StringTok{                            const imageUrl = URL.createObjectURL(imageBlob);}
\StringTok{                            document.getElementById(\textquotesingle{}resultOutput\textquotesingle{}).innerHTML = \textasciigrave{}\textless{}img src="$}\SpecialCharTok{\{imageUrl\}}\StringTok{" alt="Generated Plot" /\textgreater{}\textasciigrave{};}
\StringTok{                        \})}
\StringTok{                        .catch(error =\textgreater{} \{}
\StringTok{                            hideLoader();  // Hide loader in case of an error}
\StringTok{                            document.getElementById(\textquotesingle{}resultOutput\textquotesingle{}).innerHTML = \textasciigrave{}Error generating plot: $}\SpecialCharTok{\{error\}}\StringTok{\textasciigrave{};}
\StringTok{                        \});}
\StringTok{                        }
\StringTok{                        }
\StringTok{                \}}
\StringTok{            \textless{}/script\textgreater{}}

\StringTok{        \textless{}/body\textgreater{}}
\StringTok{        \textless{}/html\textgreater{}}
\StringTok{    """}\NormalTok{)}
\end{Highlighting}
\end{Shaded}

