\NormalTok{    old\_data }\OperatorTok{=}\NormalTok{ pd.read\_csv(}\StringTok{"Electromenagerscleaned\_data.csv"}\NormalTok{)  }\CommentTok{\# Read the existing data from the file}
    \CommentTok{\# Concatenate the cleaned data to the old data}
\NormalTok{    df\_cleaned }\OperatorTok{=}\NormalTok{ old\_data}

    \CommentTok{\# Analyze data and visualize}
