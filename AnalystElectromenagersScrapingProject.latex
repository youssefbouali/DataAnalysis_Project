\NormalTok{    top\_product, price\_variations }\OperatorTok{=}\NormalTok{ analyse\_get\_top\_product\_price\_variation(df\_cleaned)}
    
    \BuiltInTok{print}\NormalTok{(}\SpecialStringTok{f"Top Product: }\SpecialCharTok{\{}\NormalTok{top\_product}\SpecialCharTok{\}}\SpecialStringTok{"}\NormalTok{)}
    \BuiltInTok{print}\NormalTok{(}\StringTok{"Price variations by website:"}\NormalTok{)}
    \BuiltInTok{print}\NormalTok{(price\_variations)}
    \CommentTok{\# Plot the price variations}
\NormalTok{    visualisation\_plot\_price\_variations(price\_variations, top\_product)}
    
    
    \BuiltInTok{print}\NormalTok{(}\StringTok{"}\CharTok{\textbackslash{}r\textbackslash{}n}\StringTok{Average promotion par group:"}\NormalTok{)}
    \BuiltInTok{print}\NormalTok{(analyse\_promotions\_par\_categorie(df\_cleaned))}
\NormalTok{    visualisation\_plot\_promotions(analyse\_promotions\_par\_categorie(df\_cleaned), }
\NormalTok{        title}\OperatorTok{=}\StringTok{"Promotion Count by Category and Promotion Type"}\NormalTok{, }
\NormalTok{        xlabel}\OperatorTok{=}\StringTok{"Category"}\NormalTok{, }
\NormalTok{        ylabel}\OperatorTok{=}\StringTok{"Promotion Count"}\NormalTok{)}
    
    
\NormalTok{    products\_by\_date }\OperatorTok{=}\NormalTok{ analyse\_group\_by\_nom\_website\_date(df\_cleaned)}
    \BuiltInTok{print}\NormalTok{(}\StringTok{"}\CharTok{\textbackslash{}r\textbackslash{}n}\StringTok{Top 5 Products by Occurrence:"}\NormalTok{)}
