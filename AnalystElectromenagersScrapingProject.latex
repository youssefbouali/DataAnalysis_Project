\hypertarget{1266435e-fade-4307-8b5d-b4b979e0a898}{}
\begin{Shaded}
\begin{Highlighting}[]
\CommentTok{\# Function to normalize text}
\KeywordTok{def}\NormalTok{ normalize\_text(text):}
    \ControlFlowTok{if} \BuiltInTok{isinstance}\NormalTok{(text, }\BuiltInTok{str}\NormalTok{):}
\NormalTok{        text }\OperatorTok{=}\NormalTok{ text.lower()  }\CommentTok{\# Convert to lowercase}
        \CommentTok{\# nom = re.sub(r\textquotesingle{}[\^{}a{-}z\textbackslash{}s]\textquotesingle{}, \textquotesingle{}\textquotesingle{}, text)  \# Uncomment if needed for special character removal}
        \ControlFlowTok{return}\NormalTok{ text}
    \ControlFlowTok{else}\NormalTok{:}
        \CommentTok{\# Convert non{-}string inputs to a string or handle them appropriately}
        \ControlFlowTok{return} \BuiltInTok{str}\NormalTok{(text) }\ControlFlowTok{if}\NormalTok{ text }\KeywordTok{is} \KeywordTok{not} \VariableTok{None} \ControlFlowTok{else} \StringTok{""}
\end{Highlighting}
\end{Shaded}

\hypertarget{f1a3238c-c344-4dee-a5a0-84e93e515aca}{}
\begin{Shaded}
\begin{Highlighting}[]
\CommentTok{\# Function to find similar noms using RapidFuzz}
\KeywordTok{def}\NormalTok{ find\_similar\_noms(nom, nom\_list, threshold}\OperatorTok{=}\DecValTok{75}\NormalTok{):}
\NormalTok{    similar\_noms }\OperatorTok{=}\NormalTok{ []}
    \ControlFlowTok{for}\NormalTok{ other\_nom }\KeywordTok{in}\NormalTok{ nom\_list:}
        \CommentTok{\# Compute similarity score between nom and other nom}
\NormalTok{        score }\OperatorTok{=}\NormalTok{ fuzz.ratio(nom, other\_nom)}
        \ControlFlowTok{if}\NormalTok{ score }\OperatorTok{\textgreater{}=}\NormalTok{ threshold:}
\NormalTok{            similar\_noms.append((nom, other\_nom, score))}
    \ControlFlowTok{return}\NormalTok{ similar\_noms}
\end{Highlighting}
\end{Shaded}

\hypertarget{229e8403-b89b-4a0f-8bd9-112707e977d5}{}
\begin{Shaded}
\begin{Highlighting}[]
\KeywordTok{def}\NormalTok{ analyse\_get\_top\_product\_price\_variation(df):}
    \CommentTok{\# Normalize product names}
\NormalTok{    df[}\StringTok{\textquotesingle{}normalized\_nom\textquotesingle{}}\NormalTok{] }\OperatorTok{=}\NormalTok{ df[}\StringTok{\textquotesingle{}nom\textquotesingle{}}\NormalTok{].}\BuiltInTok{apply}\NormalTok{(normalize\_text)}
\NormalTok{    df[}\StringTok{\textquotesingle{}normalized\_description\textquotesingle{}}\NormalTok{] }\OperatorTok{=}\NormalTok{ df[}\StringTok{\textquotesingle{}description\textquotesingle{}}\NormalTok{].}\BuiltInTok{apply}\NormalTok{(normalize\_text)}
    
\NormalTok{    df[}\StringTok{\textquotesingle{}nom\_and\_description\textquotesingle{}}\NormalTok{] }\OperatorTok{=}\NormalTok{ df[}\StringTok{\textquotesingle{}normalized\_nom\textquotesingle{}}\NormalTok{]}\OperatorTok{+}\StringTok{" "}\OperatorTok{+}\NormalTok{df[}\StringTok{\textquotesingle{}normalized\_description\textquotesingle{}}\NormalTok{]}
    \CommentTok{\#df[\textquotesingle{}nom\_and\_description\textquotesingle{}] = df[\textquotesingle{}normalized\_nom\textquotesingle{}]}
    
    \CommentTok{\# Apply fuzzy matching to group similar product names}
\NormalTok{    unique\_noms }\OperatorTok{=}\NormalTok{ df[}\StringTok{\textquotesingle{}nom\_and\_description\textquotesingle{}}\NormalTok{].unique()}
\NormalTok{    nom\_groups }\OperatorTok{=}\NormalTok{ \{\}}

    \ControlFlowTok{for}\NormalTok{ nom }\KeywordTok{in}\NormalTok{ unique\_noms:}
\NormalTok{        group }\OperatorTok{=}\NormalTok{ find\_similar\_noms(nom, unique\_noms)}
        \ControlFlowTok{for}\NormalTok{ \_, other\_nom, \_ }\KeywordTok{in}\NormalTok{ group:}
\NormalTok{            nom\_groups[other\_nom] }\OperatorTok{=}\NormalTok{ nom  }\CommentTok{\# Group similar product names}

    \CommentTok{\# Map the grouped noms back to the DataFrame}
\NormalTok{    df[}\StringTok{\textquotesingle{}grouped\_nom\textquotesingle{}}\NormalTok{] }\OperatorTok{=}\NormalTok{ df[}\StringTok{\textquotesingle{}nom\_and\_description\textquotesingle{}}\NormalTok{].}\BuiltInTok{map}\NormalTok{(}\KeywordTok{lambda}\NormalTok{ x: nom\_groups.get(x, x))}
    
    \CommentTok{\# Remove duplicates based on product name and website before counting occurrences}
\NormalTok{    df\_unique }\OperatorTok{=}\NormalTok{ df.drop\_duplicates(subset}\OperatorTok{=}\NormalTok{[}\StringTok{\textquotesingle{}grouped\_nom\textquotesingle{}}\NormalTok{, }\StringTok{\textquotesingle{}website\textquotesingle{}}\NormalTok{])}
    
    \CommentTok{\# Count the occurrences of each product by website}
\NormalTok{    product\_counts }\OperatorTok{=}\NormalTok{ df\_unique.groupby([}\StringTok{"grouped\_nom"}\NormalTok{, }\StringTok{"website"}\NormalTok{]).size().reset\_index(name}\OperatorTok{=}\StringTok{\textquotesingle{}count\textquotesingle{}}\NormalTok{)}
    
    \CommentTok{\# Find the product with the maximum count across all websites}
\NormalTok{    top\_product }\OperatorTok{=}\NormalTok{ product\_counts.groupby(}\StringTok{\textquotesingle{}grouped\_nom\textquotesingle{}}\NormalTok{).agg(\{}\StringTok{\textquotesingle{}count\textquotesingle{}}\NormalTok{: }\StringTok{\textquotesingle{}sum\textquotesingle{}}\NormalTok{\}).idxmax().iloc[}\DecValTok{0}\NormalTok{]}

    \CommentTok{\# Get the details of that top product across websites}
\NormalTok{    top\_product\_data }\OperatorTok{=}\NormalTok{ product\_counts[product\_counts[}\StringTok{\textquotesingle{}grouped\_nom\textquotesingle{}}\NormalTok{] }\OperatorTok{==}\NormalTok{ top\_product]}
    
    \CommentTok{\# Extract price variations for that product across websites}
\NormalTok{    price\_variations }\OperatorTok{=}\NormalTok{ df[df[}\StringTok{\textquotesingle{}grouped\_nom\textquotesingle{}}\NormalTok{] }\OperatorTok{==}\NormalTok{ top\_product].drop\_duplicates(subset}\OperatorTok{=}\NormalTok{[}\StringTok{\textquotesingle{}website\textquotesingle{}}\NormalTok{])[[}\StringTok{\textquotesingle{}website\textquotesingle{}}\NormalTok{, }\StringTok{\textquotesingle{}prix\textquotesingle{}}\NormalTok{]]}

    \ControlFlowTok{return}\NormalTok{ top\_product, price\_variations.sort\_values(by}\OperatorTok{=}\StringTok{\textquotesingle{}prix\textquotesingle{}}\NormalTok{, ascending}\OperatorTok{=}\VariableTok{True}\NormalTok{)}
\end{Highlighting}
\end{Shaded}

\hypertarget{57be588f-1703-47b9-bd46-df09746ba453}{}
\begin{Shaded}
\begin{Highlighting}[]
\KeywordTok{def}\NormalTok{ visualisation\_plot\_price\_variations(price\_variations, product\_name):}
    \CommentTok{\# Visualize price variations by website}
\NormalTok{    plt.figure(figsize}\OperatorTok{=}\NormalTok{(}\DecValTok{10}\NormalTok{, }\DecValTok{6}\NormalTok{))}
\NormalTok{    plt.bar(price\_variations[}\StringTok{\textquotesingle{}website\textquotesingle{}}\NormalTok{], price\_variations[}\StringTok{\textquotesingle{}prix\textquotesingle{}}\NormalTok{], color}\OperatorTok{=}\StringTok{\textquotesingle{}skyblue\textquotesingle{}}\NormalTok{)}
\NormalTok{    plt.title(}\SpecialStringTok{f"Price Variations for }\SpecialCharTok{\{}\NormalTok{product\_name}\SpecialCharTok{\}}\SpecialStringTok{ Across Websites"}\NormalTok{)}
\NormalTok{    plt.xlabel(}\StringTok{\textquotesingle{}Website\textquotesingle{}}\NormalTok{)}
\NormalTok{    plt.ylabel(}\StringTok{\textquotesingle{}Price\textquotesingle{}}\NormalTok{)}
\NormalTok{    plt.xticks(rotation}\OperatorTok{=}\DecValTok{45}\NormalTok{, ha}\OperatorTok{=}\StringTok{"right"}\NormalTok{)}
\NormalTok{    plt.tight\_layout()}
\NormalTok{    plt.show()}
\end{Highlighting}
\end{Shaded}

\hypertarget{bc227788-5b35-4fc1-8278-90639bee279b}{}
\begin{Shaded}
\begin{Highlighting}[]
\CommentTok{\# Analyze data}
\KeywordTok{def}\NormalTok{ analyse\_promotions\_par\_categorie(df):}
    \CommentTok{\# Filter products on promotion}
\NormalTok{    promotion\_df }\OperatorTok{=}\NormalTok{ df[df[}\StringTok{\textquotesingle{}promotion\textquotesingle{}}\NormalTok{] }\OperatorTok{!=} \StringTok{""}\NormalTok{]}

    \CommentTok{\# Count promotions by category}
\NormalTok{    promotions\_par\_categorie }\OperatorTok{=}\NormalTok{ promotion\_df.groupby([}\StringTok{\textquotesingle{}category\textquotesingle{}}\NormalTok{, }\StringTok{\textquotesingle{}promotion\textquotesingle{}}\NormalTok{])[}\StringTok{\textquotesingle{}promotion\textquotesingle{}}\NormalTok{].size().reset\_index(name}\OperatorTok{=}\StringTok{"count"}\NormalTok{)}

    \CommentTok{\# Sort by \textquotesingle{}count\textquotesingle{} in descending order and get the top 5}
\NormalTok{    top\_promotions }\OperatorTok{=}\NormalTok{ promotions\_par\_categorie.sort\_values(by}\OperatorTok{=}\StringTok{\textquotesingle{}count\textquotesingle{}}\NormalTok{, ascending}\OperatorTok{=}\VariableTok{False}\NormalTok{).head(}\DecValTok{10}\NormalTok{).sort\_values(by}\OperatorTok{=}\StringTok{\textquotesingle{}count\textquotesingle{}}\NormalTok{, ascending}\OperatorTok{=}\VariableTok{True}\NormalTok{)}

    \ControlFlowTok{return}\NormalTok{ top\_promotions}
\end{Highlighting}
\end{Shaded}

\hypertarget{cda47ad1-94da-458d-b1e4-5f7143c5b9ea}{}
\begin{Shaded}
\begin{Highlighting}[]
\KeywordTok{def}\NormalTok{ visualisation\_plot\_promotions(promotions\_par\_categorie, title}\OperatorTok{=}\StringTok{"Promotion Count by Category and Promotion Type"}\NormalTok{, xlabel}\OperatorTok{=}\StringTok{"Category"}\NormalTok{, ylabel}\OperatorTok{=}\StringTok{"Promotion Count"}\NormalTok{):}
    \CommentTok{\# Create a Seaborn barplot for better visual representation}
\NormalTok{    plt.figure(figsize}\OperatorTok{=}\NormalTok{(}\DecValTok{12}\NormalTok{, }\DecValTok{6}\NormalTok{))}
\NormalTok{    sns.barplot(data}\OperatorTok{=}\NormalTok{promotions\_par\_categorie, }
\NormalTok{        x}\OperatorTok{=}\StringTok{\textquotesingle{}category\textquotesingle{}}\NormalTok{, }
\NormalTok{        y}\OperatorTok{=}\StringTok{\textquotesingle{}count\textquotesingle{}}\NormalTok{, }
\NormalTok{        hue}\OperatorTok{=}\StringTok{\textquotesingle{}promotion\textquotesingle{}}\NormalTok{, }
\NormalTok{        palette}\OperatorTok{=}\StringTok{"Set2"}\NormalTok{)}
    
    \CommentTok{\# Customize the plot}
\NormalTok{    plt.title(title)}
\NormalTok{    plt.xlabel(xlabel)}
\NormalTok{    plt.ylabel(ylabel)}
\NormalTok{    plt.xticks(rotation}\OperatorTok{=}\DecValTok{45}\NormalTok{, ha}\OperatorTok{=}\StringTok{"right"}\NormalTok{)}
\NormalTok{    plt.tight\_layout()}
\NormalTok{    plt.show()}
\end{Highlighting}
\end{Shaded}

\hypertarget{8861013f-5892-4101-b651-f50eececc488}{}
\begin{Shaded}
\begin{Highlighting}[]
\CommentTok{\# Function to group by \textquotesingle{}nom\textquotesingle{}, \textquotesingle{}website\textquotesingle{}, and \textquotesingle{}date\_scraped\textquotesingle{}, and sort by count}
\KeywordTok{def}\NormalTok{ analyse\_group\_by\_nom\_website\_date(df):}
    \CommentTok{\# Group by \textquotesingle{}nom\textquotesingle{} and \textquotesingle{}website\textquotesingle{} and calculate min, mean, max, and count of \textquotesingle{}prix\textquotesingle{}}
\NormalTok{    avg\_prices }\OperatorTok{=}\NormalTok{ df.groupby([}\StringTok{"nom"}\NormalTok{, }\StringTok{"website"}\NormalTok{])[}\StringTok{"prix"}\NormalTok{].agg([}\StringTok{"min"}\NormalTok{, }\StringTok{"mean"}\NormalTok{, }\StringTok{"max"}\NormalTok{, }\StringTok{"count"}\NormalTok{])}

    \CommentTok{\# Filter out rows where the min price is equal to the max price}
\NormalTok{    grouped }\OperatorTok{=}\NormalTok{ avg\_prices[avg\_prices[}\StringTok{"min"}\NormalTok{] }\OperatorTok{!=}\NormalTok{ avg\_prices[}\StringTok{"max"}\NormalTok{]]}

    \CommentTok{\# Sort by \textquotesingle{}count\textquotesingle{} in descending order to get the top products}
\NormalTok{    grouped\_sorted }\OperatorTok{=}\NormalTok{ grouped.sort\_values(by}\OperatorTok{=}\StringTok{\textquotesingle{}count\textquotesingle{}}\NormalTok{, ascending}\OperatorTok{=}\VariableTok{False}\NormalTok{)}

    \CommentTok{\# Get the top 5 products with the most occurrences}
\NormalTok{    products\_by\_date }\OperatorTok{=}\NormalTok{ grouped\_sorted.groupby(}\StringTok{\textquotesingle{}nom\textquotesingle{}}\NormalTok{).head(}\DecValTok{1}\NormalTok{).sort\_values(by}\OperatorTok{=}\StringTok{\textquotesingle{}count\textquotesingle{}}\NormalTok{, ascending}\OperatorTok{=}\VariableTok{False}\NormalTok{).head(}\DecValTok{10}\NormalTok{)}

    \CommentTok{\# Reset the index so \textquotesingle{}nom\textquotesingle{} becomes a column again}
\NormalTok{    products\_by\_date }\OperatorTok{=}\NormalTok{ products\_by\_date.reset\_index()}

    \ControlFlowTok{return}\NormalTok{ products\_by\_date}
\end{Highlighting}
\end{Shaded}

\hypertarget{546ba214-b06e-4b97-a1c0-a95e80376019}{}
\begin{Shaded}
\begin{Highlighting}[]
\CommentTok{\# Function to plot price variations by \textquotesingle{}date\_scraped\textquotesingle{} for the top 5 products}
\KeywordTok{def}\NormalTok{ visualisation\_plot\_price\_variations\_by\_date(df, products\_by\_date):}
    \CommentTok{\# Filter the original dataframe to include only the top 5 products}
\NormalTok{    filtered\_df }\OperatorTok{=}\NormalTok{ df[df[}\StringTok{\textquotesingle{}nom\textquotesingle{}}\NormalTok{].isin(products\_by\_date[}\StringTok{\textquotesingle{}nom\textquotesingle{}}\NormalTok{])].copy()}

    \CommentTok{\# Replace NaN values in the \textquotesingle{}promotion\textquotesingle{} column with \textquotesingle{}No promo\textquotesingle{} using .loc}
\NormalTok{    filtered\_df.loc[:, }\StringTok{\textquotesingle{}promotion\textquotesingle{}}\NormalTok{] }\OperatorTok{=}\NormalTok{ filtered\_df[}\StringTok{\textquotesingle{}promotion\textquotesingle{}}\NormalTok{].fillna(}\StringTok{"No promo"}\NormalTok{)}

    \CommentTok{\# Create the Seaborn plot showing price variation by date}
\NormalTok{    plt.figure(figsize}\OperatorTok{=}\NormalTok{(}\DecValTok{12}\NormalTok{, }\DecValTok{6}\NormalTok{))}
\NormalTok{    sns.lineplot(data}\OperatorTok{=}\NormalTok{filtered\_df, x}\OperatorTok{=}\StringTok{\textquotesingle{}date\_scraped\textquotesingle{}}\NormalTok{, y}\OperatorTok{=}\StringTok{\textquotesingle{}prix\textquotesingle{}}\NormalTok{, hue}\OperatorTok{=}\StringTok{\textquotesingle{}nom\textquotesingle{}}\NormalTok{, marker}\OperatorTok{=}\StringTok{\textquotesingle{}o\textquotesingle{}}\NormalTok{)}

    \CommentTok{\# Add promotion names as annotations on the plot}
    \ControlFlowTok{for}\NormalTok{ \_, row }\KeywordTok{in}\NormalTok{ filtered\_df.iterrows():}
\NormalTok{        plt.text(row[}\StringTok{\textquotesingle{}date\_scraped\textquotesingle{}}\NormalTok{], row[}\StringTok{\textquotesingle{}prix\textquotesingle{}}\NormalTok{], row[}\StringTok{\textquotesingle{}promotion\textquotesingle{}}\NormalTok{], }
\NormalTok{                 color}\OperatorTok{=}\StringTok{\textquotesingle{}black\textquotesingle{}}\NormalTok{, fontsize}\OperatorTok{=}\DecValTok{9}\NormalTok{, ha}\OperatorTok{=}\StringTok{\textquotesingle{}center\textquotesingle{}}\NormalTok{, va}\OperatorTok{=}\StringTok{\textquotesingle{}bottom\textquotesingle{}}\NormalTok{)}

    \CommentTok{\# Customize the plot}
\NormalTok{    plt.title(}\StringTok{"Price Variation by Date for Top 5 Products"}\NormalTok{)}
\NormalTok{    plt.xlabel(}\StringTok{"Date Scraped"}\NormalTok{)}
\NormalTok{    plt.ylabel(}\StringTok{"Price (USD)"}\NormalTok{)}
\NormalTok{    plt.xticks(rotation}\OperatorTok{=}\DecValTok{45}\NormalTok{, ha}\OperatorTok{=}\StringTok{"right"}\NormalTok{)}
\NormalTok{    plt.tight\_layout()}
\NormalTok{    plt.show()}
\end{Highlighting}
\end{Shaded}

\hypertarget{e8e15245-8b51-4a6c-b58c-0dd2d9500710}{}
\begin{Shaded}
\begin{Highlighting}[]
\CommentTok{\# Analyze data}
\KeywordTok{def}\NormalTok{ analyse\_data\_in\_same\_site\_grouped\_sites(df, nom}\OperatorTok{=}\VariableTok{None}\NormalTok{, website}\OperatorTok{=}\VariableTok{None}\NormalTok{):}
    \CommentTok{\# Group by \textquotesingle{}nom\textquotesingle{} and \textquotesingle{}website\textquotesingle{} to get the average prices and count}
\NormalTok{    avg\_prices }\OperatorTok{=}\NormalTok{ df.groupby([}\StringTok{"nom"}\NormalTok{, }\StringTok{"website"}\NormalTok{])[}\StringTok{"prix"}\NormalTok{].agg([}\StringTok{"min"}\NormalTok{, }\StringTok{"mean"}\NormalTok{, }\StringTok{"max"}\NormalTok{, }\StringTok{"count"}\NormalTok{])}

    \CommentTok{\# Filter out rows where min equals max}
\NormalTok{    avg\_prices\_filtered }\OperatorTok{=}\NormalTok{ avg\_prices[avg\_prices[}\StringTok{"min"}\NormalTok{] }\OperatorTok{!=}\NormalTok{ avg\_prices[}\StringTok{"max"}\NormalTok{]]}

    \CommentTok{\# Group by \textquotesingle{}website\textquotesingle{} and calculate mean of \textquotesingle{}min\textquotesingle{}, \textquotesingle{}mean\textquotesingle{}, and \textquotesingle{}max\textquotesingle{}}
\NormalTok{    grouped\_by\_date }\OperatorTok{=}\NormalTok{ avg\_prices.groupby([}\StringTok{"website"}\NormalTok{]).agg(\{}
        \StringTok{\textquotesingle{}mean\textquotesingle{}}\NormalTok{: }\StringTok{\textquotesingle{}mean\textquotesingle{}}\NormalTok{,}
        \StringTok{\textquotesingle{}min\textquotesingle{}}\NormalTok{: }\StringTok{\textquotesingle{}mean\textquotesingle{}}\NormalTok{,}
        \StringTok{\textquotesingle{}max\textquotesingle{}}\NormalTok{: }\StringTok{\textquotesingle{}mean\textquotesingle{}}
\NormalTok{    \}).reset\_index()}

    \CommentTok{\# Return the result sorted by \textquotesingle{}min\textquotesingle{} in ascending order}
    \ControlFlowTok{return}\NormalTok{ grouped\_by\_date.sort\_values(by}\OperatorTok{=}\StringTok{\textquotesingle{}min\textquotesingle{}}\NormalTok{, ascending}\OperatorTok{=}\VariableTok{True}\NormalTok{)}
\end{Highlighting}
\end{Shaded}

\hypertarget{9271d49f-896b-4448-a52d-3789bbe8afde}{}
\begin{Shaded}
\begin{Highlighting}[]
\CommentTok{\# Plot data}
\KeywordTok{def}\NormalTok{ visualisation\_plot\_data(avg\_prices, nom}\OperatorTok{=}\StringTok{"Average Prices by Product"}\NormalTok{, xlabel}\OperatorTok{=}\StringTok{"Product"}\NormalTok{, ylabel}\OperatorTok{=}\StringTok{"Price (USD)"}\NormalTok{, x}\OperatorTok{=}\VariableTok{None}\NormalTok{, y}\OperatorTok{=}\VariableTok{None}\NormalTok{):}
    \CommentTok{\# Ensure the DataFrame is indexed properly for plotting}
\NormalTok{    avg\_prices }\OperatorTok{=}\NormalTok{ avg\_prices.reset\_index()  }\CommentTok{\# Reset index for clean plotting}
    
    \CommentTok{\# Plot the data}
\NormalTok{    avg\_prices.plot(kind}\OperatorTok{=}\StringTok{"bar"}\NormalTok{, title}\OperatorTok{=}\NormalTok{nom, xlabel}\OperatorTok{=}\NormalTok{xlabel, ylabel}\OperatorTok{=}\NormalTok{ylabel, x}\OperatorTok{=}\NormalTok{x, y}\OperatorTok{=}\NormalTok{y)}
    
    \CommentTok{\# Adjust layout for better display}
\NormalTok{    plt.xticks(rotation}\OperatorTok{=}\DecValTok{45}\NormalTok{, ha}\OperatorTok{=}\StringTok{"right"}\NormalTok{)}
\NormalTok{    plt.tight\_layout()}
\NormalTok{    plt.show()}
\end{Highlighting}
\end{Shaded}

