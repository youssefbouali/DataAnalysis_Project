    \CommentTok{\# Plot price variations by date for the top 5 products}
\NormalTok{    visualisation\_plot\_price\_variations\_by\_date(df\_cleaned, products\_by\_date)}
    
    
    \BuiltInTok{print}\NormalTok{(}\StringTok{"}\CharTok{\textbackslash{}r\textbackslash{}n}\StringTok{Prices by sites:"}\NormalTok{)}
    \BuiltInTok{print}\NormalTok{(analyse\_data\_in\_same\_site\_grouped\_sites(df\_cleaned))}
\NormalTok{    visualisation\_plot\_data(analyse\_data\_in\_same\_site\_grouped\_sites(df\_cleaned), }\StringTok{"Prices by sites"}\NormalTok{, }\StringTok{"Product"}\NormalTok{, }\StringTok{"Price (USD)"}\NormalTok{, }\StringTok{"website"}\NormalTok{, [}\StringTok{"min"}\NormalTok{, }\StringTok{"mean"}\NormalTok{, }\StringTok{"max"}\NormalTok{])}
